[Unit]
Description=Cheat Code Telegram Bot 24/7 Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cheatcode-bot
ExecStart=/opt/cheatcode-bot/venv/bin/python bot.py
Restart=always
RestartSec=5
EnvironmentFile=/opt/cheatcode-bot/.env

# Standard output and error logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
