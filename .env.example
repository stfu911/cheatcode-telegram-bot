# ==========================================
# CHEAT CODE TELEGRAM BOT - CONFIGURATION
# ==========================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# 2. AI Provider Selection:
# Options: "groq" (Recommended, free, ultra-fast), "gemini", "openai", "openrouter"
AI_PROVIDER=groq

# 3. Provider API Keys (Fill the one you are using):
# Get free Groq key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Get OpenAI key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Get Gemini key at: https://aistudio.google.com/
GEMINI_API_KEY=

# 4. Model Overrides (Optional - defaults to llama-3.3-70b-versatile or gemini-2.0-flash)
AI_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=600

# 5. Security Whitelist (Optional)
# Leave empty to allow anyone in Telegram. Or put comma-separated Telegram User IDs:
# ALLOWED_USER_IDS=12345678,98765432

# 6. Cloud Hosting Health Check Server (For Render / Railway / Fly.io)
ENABLE_HEALTH_SERVER=true
PORT=8080
